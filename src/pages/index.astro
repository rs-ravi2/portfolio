---
import Layout from "../layouts/Layout.astro";
import Lab from "../components/Lab.astro";
import { profile, publicLinks } from "../data/profile";
import { services, process } from "../data/services";
import { getPublicCaseStudies } from "../lib/case-studies";

const caseStudies = await getPublicCaseStudies();
const { availability: av, contact } = profile;

const nav = [
  { href: "#lab", label: "Lab" },
  { href: "#services", label: "Services" },
  ...(caseStudies.length ? [{ href: "#work", label: "Work" }] : []),
  { href: "#about", label: "About" },
  ...(contact ? [{ href: "#contact", label: "Contact" }] : []),
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.role,
  homeLocation: { "@type": "Country", name: profile.location },
  ...(profile.siteUrl ? { url: profile.siteUrl } : {}),
  ...(publicLinks.length ? { sameAs: publicLinks.map((l) => l.href) } : {}),
};
---

<Layout>
  <header class="masthead">
    <div class="wrap masthead-inner">
      <a class="wordmark" href="#top">{profile.name}</a>
      <nav aria-label="Sections">
        <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="wrap">
        <p class="kicker">{profile.name} · {profile.role} · {profile.location}, working remotely</p>
        <h1 id="hero-title">{profile.headline}</h1>
        <p class="lede">{profile.summary}</p>
        <div class="hero-actions">
          <a class="button" href="#lab">Try the retrieval lab</a>
          <a class="text-link" href="#services">See the three offers</a>
        </div>
        <dl class="facts">
          <div><dt>Experience</dt><dd>{profile.yearsExperience} years, professional</dd></div>
          <div><dt>Availability</dt><dd>{av.hoursPerWeek}</dd></div>
          <div><dt>Working style</dt><dd>{av.mode} ({profile.timezone})</dd></div>
        </dl>
      </div>
    </section>

    <Lab />

    <section id="services" class="services" aria-labelledby="services-title">
      <div class="wrap">
        <header class="section-head">
          <p class="kicker">Services</p>
          <h2 id="services-title">Three fixed-scope offers, each with a handoff you can check</h2>
          <p class="dek">
            Pick one deliverable. Before any work starts, we agree in writing on what you send, what you get back,
            and the test that decides it is done. The examples below show the shape of an engagement. They are
            illustrations, not past client work.
          </p>
        </header>

        <ol class="offer-list">
          {services.map((s, i) => (
            <li class="offer" id={`offer-${s.id}`}>
              <div class="offer-intro">
                <p class="offer-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</p>
                <h3>{s.title}</h3>
                <p>{s.summary}</p>
              </div>
              <dl class="handoff">
                <div><dt>Example input</dt><dd>{s.input}</dd></div>
                <div><dt>Output</dt><dd>{s.output}</dd></div>
                <div class="handoff-check"><dt>Accepted when</dt><dd>{s.acceptance}</dd></div>
              </dl>
            </li>
          ))}
        </ol>

        <div class="process">
          <h3>How an engagement runs</h3>
          <ol class="steps">
            {process.map((p) => (
              <li><strong>{p.step}.</strong> {p.detail}</li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    {caseStudies.length > 0 && (
      <section id="work" class="work" aria-labelledby="work-title">
        <div class="wrap">
          <header class="section-head">
            <p class="kicker">Work</p>
            <h2 id="work-title">Case studies</h2>
          </header>
          <ul class="case-list">
            {caseStudies.map((c) => (
              <li>
                <a href={`/work/${c.id}/`}><span class="case-title">{c.data.title}</span></a>
                <p>{c.data.summary}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <section id="about" class="about" aria-labelledby="about-title">
      <div class="wrap about-grid">
        <div class="about-bio">
          <p class="kicker">About</p>
          <h2 id="about-title">{profile.name}</h2>
          {profile.bio.map((p) => <p>{p}</p>)}
          {profile.employer?.show && (
            <p>Currently at {profile.employer.name}. Client work never draws on employer code or data.</p>
          )}
          {profile.tools.length > 0 && (
            <p class="tools"><span class="label">Day-to-day tools</span> {profile.tools.join(" · ")}</p>
          )}
        </div>

        <aside class="availability" aria-labelledby="availability-title">
          <h3 id="availability-title">Availability</h3>
          <dl>
            <div><dt>Hours</dt><dd>{av.hoursPerWeek}</dd></div>
            <div><dt>Working style</dt><dd>{av.mode}, {profile.timezone}</dd></div>
            <div><dt>Calls</dt><dd>{av.calls}</dd></div>
            <div><dt>Engagements</dt><dd>{av.engagement}</dd></div>
          </dl>

          {contact && (
            <div class="contact" id="contact">
              <h3>Send a project</h3>
              <p>Include:</p>
              <ol>
                <li>The problem, and what happens today</li>
                <li>A few sample inputs (anonymised is fine)</li>
                <li>The output you want back</li>
                <li>Your deadline</li>
              </ol>
              <a class="button" href={contact.href}>{contact.label}</a>
              {contact.address && (
                <p class="contact-address">Or write to <a href={`mailto:${contact.address}`}>{contact.address}</a></p>
              )}
              {contact.responseNote && <p class="small">{contact.responseNote}</p>}
            </div>
          )}

          {profile.resume && <p><a class="text-link" href={profile.resume.href}>{profile.resume.label}</a></p>}
        </aside>
      </div>
    </section>
  </main>

  <footer class="colophon">
    <div class="wrap colophon-inner">
      <p>© {new Date().getFullYear()} {profile.name}. The lab corpus is synthetic. This site sets no cookies and runs no analytics.</p>
      {publicLinks.length > 0 && (
        <ul class="links">{publicLinks.map((l) => <li><a href={l.href} rel="me">{l.label}</a></li>)}</ul>
      )}
    </div>
  </footer>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>
